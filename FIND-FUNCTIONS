#!/bin/bash
# vim:set number nowrap foldmethod=indent foldnestmax=2 nofoldenable:
#
# SCRIPT_PURPOSE describes the purpose of FIND-FUNCTIONS									\
SCRIPT_PURPOSE="This script will search a script for function(s) matching FUNCTIONPATTERN and display, or open with an editor, the functions coding found or the function comments found."
# SCRIPT_VERSION Helps keep track of FIND-FUNCTIONS changes. "FIND-FUNCIONS --version" will display this info.		\
SCRIPT_VERSION="01.01.08 - Jun 16, 2026"

