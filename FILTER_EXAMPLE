# Initialize functions.sh if preloaded into the environment. Otherwise locate and load functions.sh
if (( _functions_sh_loaded_ )) ; then		# Is functions.sh loaded?
  FUNCTIONS_SH_INIT				# Initialize functions.sh
else						# functions.sh not loaded
  COMMON_FUNCTIONS="$(type -p functions.sh)"	# Locate and load functions.sh
  [[ -x ${COMMON_FUNCTIONS} ]] && source "${COMMON_FUNCTIONS}" || { echo -e "Cannot locate "${COMMON_FUNCTIONS:-functions.sh}"." 1>&2 ; exit ; }
fi

# The following names are hard linked to the script ${DNF}. The character "@" is used for formatting output for help.
ALIAS_NAMES="@dnfe  dnfhi  dnfhl  dnfhs  dnfhu  dnfi  dnfl  dnfL  dnflsd  dnfn  dnfp  dnfr  dnfR  dnfu  dnfua"

UNAME_GLOB="$(uname -r)"
HARDWARE_PLATFORM_GLOB="${UNAME_GLOB##*.}"
unset ONLY_HARDWARE_PLATFORM_GLOB
[[ ${HARDWARE_PLATFORM_GLOB} == x86_64 ]] && OTHER_HARDWARE_PLATFORM_GLOB="i686" || OTHER_HARDWARE_PLATFORM_GLOB="x86_64"
FILE_OUT_DIR="/tmp/"				# MUST end with '/'
###### SAVE
eval FEDORA_RELEASE_GLOB=\"\${UNAME_GLOB%*.${HARDWARE_PLATFORM_GLOB}}\"
FEDORA_RELEASE_GLOB=${FEDORA_RELEASE_GLOB##*.}
NEW_RELEASE="$(( ${FEDORA_RELEASE_GLOB:2} + 1 ))"
FILE_OUT_PREFIX="dnf"
FILE_OUT_SUFFIX="$(uname -r | cut -f 4 -d .).txt"
###### SAVE
TEST_INFO="Command generated is:"
ASSUMED_ANSWER_DEFAULT="--assumeyes"		# THe default response to the 'Continue ... OK?...' question
ASSUMED_ANSWER="${ASSUMED_ANSWER_DEFAULT}"

function INSTALL_NEW_RELEASE() {
  (( Opt_document_one_alias_name )) && DOCUMENT_SHORT_NAME "INSTALL_NEW_RELEASE ==> Displays a menu of actions to implement a new release"
  local Less INFO="/info.$((NEW_RELEASE-1))"
  local DEFAULT_HISTORY_FILE="${INFO}/${FILE_OUT_PREFIX}.history.userinstalled.${FILE_OUT_SUFFIX}"
  local MENU_ARRAY MENU_HEADER MENU_LINE OUTPUT_FILE="/tmp/dnf.system-upgrade-download.output"
  [[ -z ${LESS} ]] && Less="        " || Less="${LESS}"
  Sep="\n   ==================================================="
  MENU_HEADER="Installation of a new Fedora release.${Sep}\n   Note: Ensure power management is disabled.\n         Ensure no bash jobs (in any tab) are running.${Sep}\nSelect the command to execute (normally you should execute them in order):"
  MENU_ARRAY=(
      ": ==== ${UL}PREPARE FOR UPGRADE${DEF} ====          # ============================================"
      "FEDORA-ISO-DOWNLOAD                      # Get the Fedora ${NEW_RELEASE} Workstation ISO file."
      "dnf5 install dnf-plugin-system-upgrade remove-retired-packages rpmconf meld     # Needed software."
      "dnfu -- --refresh                        # Ensure latest changes are installed (then reboot)."
      "eval DNF --hu=\"\${DEFAULT_HISTORY_FILE}\"  # Write all user-installed software (sorted)\n                                                 #   into \"${DEFAULT_HISTORY_FILE}\"."
      ": ==== ${UL}ENSURE PACKAGE INTEGITY${DEF} ====      # ============================================"
      "DNF -r                                   # rpmconf cleans .rpmnew, .rpmsave and .rpmorig files."
      "REINSTALL_BASE_REPOs                     # Ensure the base repositories are are the latest version."
      "remove-retired-packages                  #   Remove them (via query)."
      "dnf5 repoquery --duplicates              # Find duplicate packages"
      "dnf5 remove --duplicates                 #   Remove them."
      "dnf5 list --obsoletes                    # List obsoleted packages."
      "dnf5 list --extras ${Less}               # List packages installed but not from any repository."
      "dnf5 remove \$(dnf5 repoquery --extras)   #   Remove them."
      "dnf5 list --autoremove ${Less}           # List packages removed by the auroremove command."
      "dnf5 autoremove                          #   Remove them."
      "dnf5 distro-sync                         # Run this if there are depedency issues."
      "dnf5 distro-sync --allowerasing          # Ditto with more force."
      "dnf5 autoremove                          #   Again clean up leaf packages,"
      "dnf5 distro-sync                         # Ensure all installed versions match."
      "rpm --rebuilddb                          # Troubleshoot - Rebuild the rpm database"
      ": ==== ${UL}PREPARE FOR THE WORST${DEF} ====        # ============================================"
      "BACKUP --all                             # Either: Execute a full backup."
      "BACKUP --all --exclude-large-files       #     Or: A full backup except for ISO, VDI... files."
      ": ==== ${UL}DO THE UPGRADE${DEF} ====               # ============================================"
      "dnf5 system-upgrade download -y --refresh --releasever=${NEW_RELEASE} ${NEW_RELEASE_OPTIONS}                                #\n                                                 # Download the new version."
      "dnf5 system-upgrade download -y --allowerasing --refresh --releasever=${NEW_RELEASE} ${NEW_RELEASE_OPTIONS}                 #\n                                                 # Download with --allowerasing."
      "eval less \"\${OUTPUT_FILE}\"               # View the log of \"system-upgrade download\"."
      "dnf5 offline reboot                      # Reboot to install downloaded new version."
      ": ==== ${UL}DOUBLE-CHECK and UTILITIES${DEF} ====   # ============================================"
      "DNF -r                                   # Run rpmconf again for the new install."
      "DD-COPY-ISO-TO-DEVICE                    # Create a bootable device from a Fedora image."
  )
  if [[ $1 == "display" ]] ; then
    local I elements last
    elements="${#MENU_ARRAY[*]}"
    last="$(( elements - 1 ))"
    echo -n "\n"
    for ((I=0 ; I<elements ; I++)) ; do
      (( I == last )) && echo -n "\t\t${MENU_ARRAY[${I}]}" \
        ||  echo -n "\t\t${MENU_ARRAY[${I}]}\n"
    done
    return
  fi
}

